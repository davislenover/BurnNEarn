@startuml backend-classes
' FitFolio backend classes for the proof of concept. Only real classes are
' drawn. Modules of plain functions are on the package diagram and in the issues.
' Render with: plantuml -tpng backend-classes.puml

!$BUILT = "#DDF3E4;line:3B8A5A"
!$PLANNED = "#FFFFFF;line:555555;line.dashed"

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 40
skinparam ArrowColor #555555
skinparam ArrowFontSize 12
hide empty members
hide circle
set separator none

title FitFolio backend: classes and tables
caption Main columns only. A line between tables is a foreign key.\nGreen: built. Dashed box: planned.

package "app.models (tables)" {
  class User $PLANNED {
    time_zone
  }
  class Portfolio $PLANNED {
    cash_balance
    scenario_id: empty if live
  }
  class ActivityDailyTotal $PLANNED {
    activity_date
    activity_type
    step_count
    counted
  }
  class BalanceChange $PLANNED {
    amount
    reason
    activity_date
  }
  class Trade $PLANNED {
    request_id
    quantity
    unit_price
    currency_amount
    status
  }
  class Holding $PLANNED {
    quantity
  }
  class Asset $BUILT {
    symbol
    name
    asset_type
    is_tradable
  }
  class Price $BUILT {
    price
    quoted_at
    obtained_at
  }
  class ProviderRequest $PLANNED {
    symbol
    time of the call
    whether it worked
  }
}

package "app.market" {
  interface MarketDataProvider <<Protocol>> $BUILT {
    get_quote(symbol): Quote
  }
  class FinnhubProvider $BUILT
  class FakeProvider $PLANNED
  class Quote $BUILT {
    symbol
    price
    quoted_at
  }
}

package "app.core" {
  class DomainError $BUILT {
    code
    message
    status
    .. one subclass per refusal ..
  }
}

FinnhubProvider ..|> MarketDataProvider
FakeProvider ..|> MarketDataProvider
MarketDataProvider --> Quote : returns

User -- "*" Portfolio
User -- "*" ActivityDailyTotal
Portfolio -- "*" BalanceChange
Portfolio -- "*" Trade
Portfolio -- "*" Holding
Trade -left-> BalanceChange : paid by
Trade "*" -- Asset
Holding "*" -- Asset
Asset -- "*" Price

' Only sets the layout: app.core sits under app.market.
Quote -[hidden]down-> DomainError
@enduml
