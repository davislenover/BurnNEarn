@startuml backend-packages
' FitFolio backend packages for the proof of concept.
' Render with: plantuml -tpng backend-packages.puml

!$SOME = "#DDF3E4;line:3B8A5A"
!$NONE = "#FFFFFF;line:555555;line.dashed"

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam nodesep 25
skinparam ranksep 45
skinparam ArrowColor #555555
skinparam ArrowFontSize 12

title FitFolio backend: packages
caption Arrows mean "uses" and show the planned design.\nGreen: some code exists. Dashed: nothing built yet.

rectangle "**app.main**" as main $SOME
folder "**app.api**\nroutes" as api $SOME

rectangle "Services: the rules, one package per feature" as services #FAFAFA;line:BBBBBB {
  folder "**app.activity**\nsteps into rewards" as activity $NONE
  folder "**app.trading**\nbuying, portfolio value" as trading $NONE
  folder "**app.wallet**\nthe only code that\nchanges a balance" as wallet $NONE
  folder "**app.market**\nprices, market hours" as market $SOME
}

folder "**app.scripts**\ndemo data" as scripts $NONE
folder "**app.models**\ntables" as models $SOME
folder "**migrations**\nchanges to the tables" as migrations $SOME
folder "**app.core**\nsettings, database session, constants, DomainError\nused by every package" as core $SOME

main --> api
main --> market : starts the poller
api --> services
api --> models
activity --> wallet
trading --> wallet
trading --> market
services --> models
scripts --> models
migrations --> models

' Only sets the layout: app.core sits at the bottom.
models -[hidden]-> core
wallet -[hidden]-> core
@enduml
