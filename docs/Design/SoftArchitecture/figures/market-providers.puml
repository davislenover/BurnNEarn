@startuml market-providers
' Render with: plantuml -tpng docs/Design/SoftArchitecture/figures/market-providers.puml
!include style.iuml
title Market: where prices come from

interface MarketDataProvider <<strategy>> {
  +get_quote(symbol: str): Quote
}
class FinnhubProvider <<adapter>> {
  -api_key: SecretStr
  -client: httpx2.Client
  +get_quote(symbol: str): Quote
}
class FakeProvider {
  -clock: Clock
  -prices: dict[str, Decimal]
  +get_quote(symbol: str): Quote
}
class Quote <<value object>> {
  +symbol: str
  +price: Decimal
  +quoted_at: datetime
}
class MarketDataError <<exception>>
class RateLimitedError <<exception>>
class UnknownSymbolError <<exception>>
class "build_provider(settings)" as factory <<factory>> #F1EFE8
class "poll_once(session, provider, now)" as poll <<function>> #E1F5EE

MarketDataProvider <|-- FinnhubProvider
MarketDataProvider <|-- FakeProvider
MarketDataProvider ..> Quote : returns
MarketDataProvider ..> MarketDataError : raises
MarketDataError <|-- RateLimitedError
MarketDataError <|-- UnknownSymbolError
factory ..> MarketDataProvider : creates the one\nMARKET_PROVIDER names
poll ..> MarketDataProvider : is given one,\ncalls get_quote
@enduml
