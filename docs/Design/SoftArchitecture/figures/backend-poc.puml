@startuml backend-poc
' PoC backend: modules on a small kernel. Render with:
'   plantuml -tpng docs/Design/SoftArchitecture/figures/backend-poc.puml
skinparam componentStyle uml2
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam ArrowColor #555555
skinparam component {
  BackgroundColor #EEEDFE
  BorderColor #534AB7
}
skinparam rectangle {
  BorderColor #888780
}
skinparam database {
  BackgroundColor #F1EFE8
  BorderColor #888780
}
skinparam cloud {
  BackgroundColor #F1EFE8
  BorderColor #888780
}

component "Phone app\nHTTPS, JSON" as phone <<client>> #FFFFFF;line:888780

rectangle "FitFolio server (one FastAPI process)" as server {
  component "Composition root\ncreate_app() adds each\nmodule's routes" as root #F1EFE8;line:5F5E5A
  rectangle "Modules (each owns its tables)" as modules {
    component "trading" as trading
    component "activity" as activity
    component "market" as market
    component "wallet" as wallet
    component "users" as users
  }
  component "Kernel (app/core)\nclock, money, database session" as core #F1EFE8;line:5F5E5A
}

database "PostgreSQL" as pg #E6F1FB;line:185FA5
cloud "Finnhub" as finnhub #FFFFFF

phone -down-> root
root -down-> modules
modules -down-> core
core -down-> pg
market -left-> finnhub : prices
users -[hidden]down- core

trading -[hidden]right- activity
trading -[hidden]down- market
activity -[hidden]down- wallet
market -[hidden]right- wallet
wallet -[hidden]down- users

note right of modules
  Calls only go down.
  A module is used only through its
  interface.py, queries.py and types.py.
end note

skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #B4B2A9
legend right
  <color:#5F5E5A>■</color> Kernel
  <color:#534AB7>■</color> Module
  <color:#185FA5>■</color> Database
  □ Outside the server
endlegend
@enduml
