@startuml wallet
' Render with: plantuml -tpng docs/Design/SoftArchitecture/figures/wallet.puml
!include style.iuml
title Wallet module: its files

class "plugin.py" as plugin <<entry point>> {
  + PLUGIN: Plugin
}
class "routes.py" as routes <<entry point>> {
  + GET /v1/me/balance: Balance
  ~ router: APIRouter
  ~ Balance
}

class "interface.py" as interface <<public>> {
  + lock_live_portfolio(session, user_id): LockedPortfolio
  + change_balance(session, locked, amount, reason, activity_date = None): BalanceChangeReceipt
  + create_live_portfolio(session, user_id): UUID
  + delete_portfolio(session, portfolio_id)
}
class "queries.py" as queries <<public>> {
  + live_portfolio_id(session, user_id): UUID
  + get_balance(session, portfolio_id): Decimal
  + activity_paid(session, portfolio_id, activity_date): Decimal
}
class "types.py" as types <<public>> {
  + BalanceChangeReason
  + LockedPortfolio, BalanceChangeReceipt
  + InsufficientFundsError
}

class "service.py" as service <<logic>> {
  ~ lock_live_portfolio(session, user_id): LockedPortfolio
  ~ change_balance(session, locked, amount, reason, activity_date = None): BalanceChangeReceipt
  ~ create_live_portfolio(session, user_id): UUID
  ~ delete_portfolio(session, portfolio_id)
  {field} ~ FOUR_DECIMALS = Decimal("0.0001")
  - _check_amount(amount)
}
class "models.py" as models <<table>> {
  ~ Portfolio: the portfolios table
  ~ BalanceChange: the balance_changes table
  {field} ~ AMOUNT = Numeric(16, 4)
  - _REASONS: the reasons, for a check
}

package "Other modules, public files only" as others {
  class "users" as users <<public>> {
    + get_current_user(): CurrentUser
  }
}

plugin --> routes
plugin -down-> models : registers
routes -left-> users
routes -down-> queries
interface -down-> service : re-exports
queries -down-> models
service -down-> models
models -down-> types
queries -down-> types
service -down-> types

routes -[hidden]right- interface
queries -[hidden]right- service

legend right
  <color:#854F0B>■</color> Entry point: how the app reaches the module
  <color:#0F6E56>■</color> Public: what other modules may import
  <color:#534AB7>■</color> Logic
  <color:#185FA5>■</color> Tables
  + other modules or the phone may use it
  ~ only this module's files may use it
  - only its own file uses it
  An arrow means "uses".
endlegend
@enduml
