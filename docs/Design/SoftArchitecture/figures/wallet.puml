@startuml wallet
' Render with: plantuml -tpng docs/Design/SoftArchitecture/figures/wallet.puml
!include style.iuml
title Wallet module

class "plugin.py" as plugin <<entry point>> {
  PLUGIN = Plugin(name, router)
}
class "routes.py" as routes <<entry point>> {
  GET /v1/me/balance
}

class "interface.py" as interface <<public>> {
  lock_live_portfolio(session, user_id): LockedPortfolio
  change_balance(session, locked, amount, reason, activity_date = None): BalanceChangeReceipt
  create_live_portfolio(session, user_id): portfolio_id
  delete_portfolio(session, portfolio_id)
}
class "queries.py" as queries <<public>> {
  live_portfolio_id(session, user_id)
  get_balance(session, portfolio_id)
  activity_paid(session, portfolio_id, activity_date)
}
class "types.py" as types <<public>> {
  LockedPortfolio: portfolio_id, user_id
  BalanceChangeReceipt: balance_change_id, amount, cash_balance_after
  BalanceChangeReason: activity_reward, trade_purchase
}
class InsufficientFundsError <<error>> {
  409 insufficient_funds
}

class "service.py" as service <<logic>> {
  the rules behind interface.py
  never commits
}

package "Tables (models.py)" as tables {
  class "portfolios" as portfolios <<table>> {
    user_id refers to a user
    cash_balance >= 0
    one live portfolio per user
  }
  class "balance_changes" as changes <<table>> {
    amount != 0, never edited
  }
}

plugin --> tables : registers
plugin --> routes
interface --> service
service --> types
service --> InsufficientFundsError : raises
service --> tables
queries --> tables
routes --> queries
changes --> portfolios : deleted with

note bottom of service
  change_balance is the only code that changes
  cash_balance. It is one UPDATE that applies only
  if the balance stays at 0 or more, then one new
  balance_changes row. Callers lock the portfolio
  first with lock_live_portfolio.
end note

legend right
  <color:#854F0B>■</color> Entry point: how the app reaches the module
  <color:#0F6E56>■</color> Public: what other modules may import
  <color:#534AB7>■</color> Logic
  <color:#185FA5>■</color> Table
  <color:#A32D2D>■</color> Error
  An arrow means "uses".
endlegend
@enduml
