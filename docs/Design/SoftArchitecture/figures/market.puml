@startuml market
' Render with: plantuml -tpng docs/Design/SoftArchitecture/figures/market.puml
!include style.iuml
title Market module

package "Public: other modules import only these" #FAFAFA {
  class queries <<module>> {
    +is_market_open(now): bool
    +get_asset_by_symbol(session, symbol): AssetInfo
    +get_asset(session, asset_id): AssetInfo
    +get_current_price(session, asset_id, now): CurrentPrice | None
    +is_delayed(quoted_at, now): bool
  }
  class types <<module>> {
    AssetInfo: asset_id, symbol, name, is_tradable
    CurrentPrice: price, quoted_at, obtained_at, delayed
    UnknownAssetError: 404 unknown_asset
  }
}

class routes <<module>> {
  GET /v1/assets
  GET /v1/market/usage
}
class plugin <<module>> {
  +PLUGIN = Plugin(name, router, lifespan)
}
class poller <<module>> {
  +lifespan(app): starts and stops the thread
  +run_poller(stop, provider, clock, session_factory)
  +should_poll(now): bool
  +poll_once(session, provider, now)
  +save_quote(session, asset_id, quote)
}
class calendar <<module>> {
  +is_trading_time(now): bool
  +is_market_open(now): bool
}
class MarketSettings {
  +market_provider: "finnhub" | "fake"
  +finnhub_api_key: SecretStr | None
  +market_always_open: bool
  +market_poller_enabled: bool
}
class providers <<package>> {
  +build_provider(settings): MarketDataProvider
}
class Asset <<table assets>> {
  asset_id, symbol, name, is_tradable
}
class Price <<table prices>> {
  asset_id, price, quoted_at, obtained_at
}
class ProviderRequest <<table provider_requests>> {
  requested_at, symbol, outcome
}

plugin ..> routes
plugin ..> poller
routes ..> queries
queries ..> types
queries ..> calendar
queries ..> Price
queries ..> Asset
poller ..> providers : provider
poller ..> Price : saves
poller ..> ProviderRequest : records each call
poller ..> Asset : reads tradable
poller ..> calendar
poller ..> MarketSettings
calendar ..> MarketSettings
providers ..> MarketSettings
Price "*" --> "1" Asset
@enduml
