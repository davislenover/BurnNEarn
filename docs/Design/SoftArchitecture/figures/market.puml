@startuml market
' Render with: plantuml -tpng docs/Design/SoftArchitecture/figures/market.puml
!include style.iuml
title Market module: its files

class "plugin.py" as plugin <<entry point>> {
  + PLUGIN: Plugin
}
class "routes.py" as routes <<entry point>> {
  + GET /v1/assets: AssetList
  + GET /v1/market/usage: Usage
  ~ router: APIRouter
  ~ AssetList, AssetPrice, Usage
}

class "queries.py" as queries <<public>> {
  + get_asset_by_symbol(session, symbol): AssetInfo
  + get_asset(session, asset_id): AssetInfo
  + get_current_price(session, asset_id, now): CurrentPrice or None
  + is_delayed(quoted_at, now): bool
  + is_market_open(now): bool
  - _asset_info(asset): AssetInfo
}
class "types.py" as types <<public>> {
  + AssetInfo, CurrentPrice
  + UnknownAssetError
}

class "poller.py" as poller <<logic>> {
  ~ POLL_INTERVAL = 60 s
  ~ POLL_AFTER_CLOSE = 15 min
  ~ STOP_TIMEOUT = 15 s
  ~ lifespan(app)
  ~ health(): ModuleHealth
  ~ run_poller(stop, provider, clock, session_factory, interval)
  ~ should_poll(now): bool
  ~ poll_once(session, provider, now): bool
  ~ save_quote(session, asset_id, quote)
  - _record(session, symbol, now, outcome)
  - _status: _Status
}
class "calendar.py" as calendar <<logic>> {
  ~ NEW_YORK, OPENS_AT, CLOSES_AT, EARLY_CLOSE_AT
  ~ HOLIDAYS, EARLY_CLOSES
  ~ is_trading_time(now): bool
  ~ is_market_open(now): bool
}
class "settings.py" as settings <<settings>> {
  ~ MarketSettings
  ~ get_market_settings(): MarketSettings
  ~ check_always_open(market, providers)
}
class "providers/" as providers <<provider>> {
  ~ build_provider(settings): MarketDataProvider
  ~ provider_type(settings): type of MarketDataProvider
  ~ MarketDataProvider, Quote, MarketDataError
  ~ get_provider_settings(): ProviderSettings
}
class "models.py" as models <<table>> {
  ~ Asset: the assets table
  ~ Price: the prices table
  ~ ProviderRequest: the provider_requests table
  ~ RequestOutcome
}

plugin --> routes
plugin --> poller
routes --> queries
queries -left-> types
queries --> models
queries --> calendar
routes --> models
routes --> calendar
routes --> providers
poller --> calendar
poller --> models
poller --> settings
poller --> providers
calendar -right-> settings
settings -right-> providers
models -[hidden]right- calendar

legend right
  <color:#854F0B>■</color> Entry point: how the app reaches the module
  <color:#0F6E56>■</color> Public: what other modules may import
  <color:#534AB7>■</color> Logic
  <color:#993556>■</color> Providers: where prices come from
  <color:#3B6D11>■</color> Settings
  <color:#185FA5>■</color> Tables
  + other modules or the phone may use it
  ~ only this module's files may use it
  - only its own file uses it
  An arrow means "uses".
endlegend
@enduml
