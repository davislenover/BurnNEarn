@startuml request-assets
' Render with: plantuml -tpng docs/Design/SoftArchitecture/figures/request-assets.puml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EEEDFE
skinparam ParticipantBorderColor #534AB7
title A request: GET /v1/assets

actor "Phone" as phone
participant "FastAPI app\n(kernel)" as app
participant "market routes" as routes
participant "market queries" as queries
database "PostgreSQL" as db

phone -> app : GET /v1/assets
app -> routes : list_assets(db, clock)
note right of app
  The kernel hands the route a database
  session (get_db) and the clock (get_clock).
end note
loop each tradable stock
  routes -> queries : get_current_price(asset_id, now)
  queries -> db : newest price
  queries --> routes : CurrentPrice (read-only)
end
routes --> app : AssetList
app --> phone : JSON, prices as text
@enduml
