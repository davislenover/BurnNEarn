@startuml plugin-kernel
' Render with: plantuml -tpng docs/Design/SoftArchitecture/figures/plugin-kernel.puml
!include style.iuml
title Plug-in kernel: modules plug in, the kernel never changes

class "create_app()" as create_app <<kernel>> {
  adds each plugin's routes under /v1,
  runs each plugin's lifespan, and shows
  each plugin's health in GET /v1/health
}
class "PLUGINS (registry.py)" as registry <<kernel>> {
  the list of modules
}
class Plugin <<kernel>> {
  name
  router
  lifespan
  health: needed with a lifespan
}

class "market PLUGIN" as market <<entry point>> {
  router = routes.router
  lifespan = poller.lifespan
  health = poller.health
}
class "wallet PLUGIN (#189)" as wallet <<not built yet>>
class "activity PLUGIN (#190)" as activity <<not built yet>>
class "trading PLUGIN (#188)" as trading <<not built yet>>

create_app --> registry : reads
create_app -left-> Plugin : uses
registry --> market
registry --> wallet
registry --> activity
registry --> trading
market -up-|> Plugin

legend right
  <color:#5F5E5A>■</color> Kernel
  <color:#854F0B>■</color> A module's plugin
  <color:#B4B2A9>□</color> Not built yet
  To add a module: write its plugin.py
  and add one line to PLUGINS.
endlegend
@enduml
