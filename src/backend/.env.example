# Copy this file to .env and fill in your own values. Never commit .env.
# Settings are grouped by the module that reads them.

# --- core ---

# PostgreSQL connection used by the app and by Alembic migrations.
DATABASE_URL=postgresql+psycopg://fitfolio:fitfolio@localhost:5432/fitfolio

# --- market ---

# Where prices come from: "fake" makes up prices and needs no key, "finnhub"
# uses real prices and needs FINNHUB_API_KEY.
MARKET_PROVIDER=fake
# Your Finnhub key (https://finnhub.io). Keep it only in your own .env.
FINNHUB_API_KEY=

# Treat the market as open at any time, to develop in the evening. Only
# works with MARKET_PROVIDER=fake.
MARKET_ALWAYS_OPEN=false

# Update prices every minute while the market is open, on a background
# thread. Turn it off if you don't need prices.
MARKET_POLLER_ENABLED=true

# --- users ---

# The PoC has no sign-in, so every request is the demo user while this is
# on. Routes that need a user answer 401 while it is off.
DEMO_USER_ENABLED=true
