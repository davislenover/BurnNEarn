# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection used by the app and by Alembic migrations.
DATABASE_URL=postgresql+psycopg://fitfolio:fitfolio@localhost:5432/fitfolio

# Finnhub API key (https://finnhub.io). Not needed until market data is
# added. Keep the real key only in your own .env.
FINNHUB_API_KEY=
