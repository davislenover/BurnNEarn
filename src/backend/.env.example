# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection used by the app and by Alembic migrations.
DATABASE_URL=postgresql+psycopg://fitfolio:fitfolio@localhost:5432/fitfolio

# Market: where prices come from. "fake" makes up prices and needs no key.
# "finnhub" needs FINNHUB_API_KEY (https://finnhub.io). Keep the real key
# only in your own .env.
MARKET_PROVIDER=fake
FINNHUB_API_KEY=
