
{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@kingstinct/react-native-healthkit": "^16.2.0",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-sensors": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.37.2"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/../../test/frontend"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "<rootDir>/app/services/api/**/*.ts"
    ]
  },
  "private": true
}
